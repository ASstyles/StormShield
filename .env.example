# ==========================================
# STORMSHIELD X
# Environment Configuration Template (.env.example)
# Copy to .env and configure for your environment
# ==========================================

# Application
APP_NAME=StormShield X
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false

# Ports & Connectivity
FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL with PostGIS)
# Generate a strong password in your local .env
POSTGRES_DB=stormshield
POSTGRES_USER=stormshield
POSTGRES_PASSWORD=<your-secure-local-password>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql://stormshield:<your-secure-local-password>@postgres:5432/stormshield

# Google Gemini AI Integration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# Model requirement: gemini-3.8-flash (Latest stable Flash model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60

# Google Earth Engine (Optional)
GEE_ENABLED=false
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# Data Providers (demo / live)
WEATHER_PROVIDER=demo
SATELLITE_PROVIDER=demo
INFRASTRUCTURE_PROVIDER=demo
CYCLONE_PROVIDER=demo

# Security & CORS Whitelist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://frontend:80,http://frontend

# Upload Limits
MAX_IMAGE_SIZE_MB=10

# Logging & Observability
LOG_LEVEL=INFO

# Risk Engine Model Weights (Sum to 1.0)
RISK_WEIGHT_FLOOD=0.35
RISK_WEIGHT_SURGE=0.25
RISK_WEIGHT_WIND=0.20
RISK_WEIGHT_INFRASTRUCTURE=0.20

FLOOD_WEIGHT_RAINFALL=0.35
FLOOD_WEIGHT_ELEVATION=0.30
FLOOD_WEIGHT_COASTAL=0.20
FLOOD_WEIGHT_HISTORICAL=0.15
